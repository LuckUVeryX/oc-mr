{
  "name": "oc-mr",
  "version": "1.0.0",
  "description": "Open the latest GitLab merge request for your current branch from OpenCode.",
  "keywords": [
    "gitlab",
    "merge-request",
    "opencode",
    "plugin"
  ],
  "license": "ISC",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "format": "oxfmt --write .",
    "format:ci": "oxfmt --check .",
    "lint": "oxlint --deny-warnings",
    "lint:ci": "npm run lint",
    "test": "vitest run",
    "test:ci": "npm run test",
    "typecheck": "tsc --noEmit",
    "typecheck:ci": "npm run typecheck",
    "check": "npm run format:ci && npm run lint:ci && npm run typecheck:ci && npm run test:ci",
    "patch:toolchain": "effect-tsgo patch --typescript --oxlint"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.1",
    "@effect/platform-node-shared": "4.0.1",
    "@opencode/schema": "^2.0.27"
  },
  "devDependencies": {
    "@effect/tsgo": "0.48.1",
    "@effect/vitest": "4.0.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.27",
    "effect": "^4.0.1"
  }
}
